# Agen AI bawaan: codex atau claude. Bisa dipilih per video di UI atau dengan --agent.
AGENT=codex
# Codex memakai login ChatGPT dari `codex login`.
# Default mengikuti executable dan konfigurasi model CLI.
CODEX_BIN=codex
CODEX_MODEL=
# Claude memakai login langganan dari `claude login` (ANTHROPIC_API_KEY diabaikan).
CLAUDE_BIN=claude
CLAUDE_MODEL=
# Timeout ditentukan pengguna di UI atau melalui --timeout (detik).
# Nilai 0 berarti tanpa batas waktu; tidak ada batas bawaan lain.
PORT=8077
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=-5%
REMOTION_GL=angle
